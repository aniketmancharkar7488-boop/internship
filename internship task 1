import socket
import urllib.request

# -----------------------------
# Function to scan open ports
# -----------------------------
def scan_ports(target):
    common_ports = [21, 22, 23, 80, 443]
    open_ports = []

    for port in common_ports:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(1)

        if s.connect_ex((target, port)) == 0:
            open_ports.append(port)

        s.close()

    return open_ports


# -----------------------------
# Function to check security headers
# -----------------------------
def check_headers(url):
    required_headers = [
        "X-Frame-Options",
        "X-Content-Type-Options",
        "Content-Security-Policy"
    ]

    missing_headers = []

    try:
        response = urllib.request.urlopen(url)
        headers = response.headers

        for header in required_headers:
            if header not in headers:
                missing_headers.append(header)

    except:
        print("Could not connect to website")

    return missing_headers


# -----------------------------
# Main Program
# -----------------------------
def vulnerability_scan():
    target = input("Enter target IP (e.g. 127.0.0.1): ")
    url = input("Enter website URL (e.g. http://localhost): ")

    print("\nScanning...\n")

    open_ports = scan_ports(target)
    missing_headers = check_headers(url)

    print("----- Scan Report -----")

    if open_ports:
        print("Open Ports Found:", open_ports)
    else:
        print("No open ports found")

    if missing_headers:
        print("\nMissing Security Headers:")
        for h in missing_headers:
            print("-", h)
    else:
        print("\nAll security headers are present")

    print("\nScan completed.")


# Run the scanner
vulnerability_scan()
